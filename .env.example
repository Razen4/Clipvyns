# Firebase configuration used for account sign-in and clipboard metadata sync.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Filebase is S3-compatible. The desktop app signs requests directly, so these
# credentials are bundled into each installed application. Use a *dedicated*
# Filebase key restricted to this one bucket, and rotate it before every public
# release. A direct client cannot keep a shared S3 secret private.
VITE_FILEBASE_ENDPOINT=https://s3.filebase.io
VITE_FILEBASE_BUCKET=
VITE_FILEBASE_REGION=us-east-1
VITE_FILEBASE_ACCESS_KEY=
VITE_FILEBASE_SECRET_KEY=
