# Phase 1 is fully local and does not read environment variables.
# These public client values will be consumed when Firebase auth/sync is added in Phase 3.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Added in Phase 4. This is the Cloudflare Worker URL only; never put Filebase
# access keys or secret keys in a VITE_ variable or in the desktop application.
VITE_STORAGE_API_URL=
