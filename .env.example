# Firebase configuration used for account sign-in and clipboard metadata sync.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Vercel web deployment uses these same public Firebase web values. Do not add
# service-account credentials or storage secrets to a VITE_ variable.
