{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipboard-sharings-storage",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "vars": {
    "FIREBASE_PROJECT_ID": "leaning-win",
    "FILEBASE_ENDPOINT": "https://s3.filebase.io",
    "FILEBASE_REGION": "auto",
    "FILEBASE_BUCKET": "clipboardsharings",
    "ALLOWED_ORIGINS": "tauri://localhost,http://tauri.localhost,https://tauri.localhost"
  }
}
