# Non-secret Worker configuration
FIREBASE_PROJECT_ID=leaning-win
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_REGION=auto
FILEBASE_BUCKET=clipboardsharings
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Filebase credentials: copy values from console.filebase.com/keys only into
# worker/.dev.vars for local development, or store them with Wrangler secrets.
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=
